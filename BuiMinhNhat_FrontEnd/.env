# Cấu hình API URL cho hệ thống Chấm Công
# 1. Nếu chạy trên máy ảo Android Emulator: dùng 10.0.2.2:5000
# 2. Nếu chạy trên Windows Desktop / Web: dùng localhost:5000
# 3. Nếu chạy qua Conveyor Cloud: thay bằng link conveyor https://xxxx.conveyor.cloud
# Người dùng cũng có thể đổi trực tiếp ngay trên App qua nút Server Config
API_BASE_URL=http://localhost:5000
CONVEYOR_URL=http://localhost:5000
EMULATOR_URL=http://10.0.2.2:5000
